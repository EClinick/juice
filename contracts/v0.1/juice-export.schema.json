{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EClinick/juice/master/contracts/v0.1/juice-export.schema.json",
  "title": "Juice JSON export contract 0.1",
  "oneOf": [
    { "$ref": "#/$defs/errorDocument" },
    { "$ref": "#/$defs/nowDocument" },
    { "$ref": "#/$defs/topDocument" },
    { "$ref": "#/$defs/sourcesDocument" },
    { "$ref": "#/$defs/verifyDocument" }
  ],
  "$defs": {
    "baseDocument": {
      "type": "object",
      "required": ["schemaVersion", "platform", "command", "generatedAt", "ok"],
      "properties": {
        "schemaVersion": { "const": "0.1" },
        "platform": { "enum": ["windows", "macOS"] },
        "command": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "ok": { "type": "boolean" },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }
      }
    },
    "rails": {
      "type": "object",
      "properties": {
        "cpu": { "type": "number", "minimum": 0 },
        "gpu": { "type": "number", "minimum": 0 },
        "npu": { "type": "number", "minimum": 0 },
        "supply": { "type": "number", "minimum": 0 }
      }
    },
    "measurement": {
      "type": "object",
      "required": ["confidence"],
      "properties": {
        "confidence": { "enum": ["measured", "estimated", "unavailable"] },
        "source": { "type": "string" },
        "systemWatts": { "type": "number", "minimum": 0 },
        "rails": { "$ref": "#/$defs/rails" }
      }
    },
    "battery": {
      "type": "object",
      "required": ["present"],
      "properties": {
        "present": { "type": "boolean" },
        "percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "flow": { "enum": ["discharging", "charging", "pluggedIn", "unknown"] },
        "chargeWatts": { "type": "number", "minimum": 0 },
        "remainingWattHours": { "type": "number", "minimum": 0 },
        "fullChargeWattHours": { "type": "number", "minimum": 0 }
      }
    },
    "window": {
      "type": "object",
      "required": ["start", "end", "seconds"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "seconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "rate": {
      "type": "object",
      "required": ["pricePerKwh", "currency", "isEstimate"],
      "properties": {
        "pricePerKwh": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "regionCode": { "type": "string" },
        "regionName": { "type": "string" },
        "isEstimate": { "type": "boolean" }
      }
    },
    "appEnergy": {
      "type": "object",
      "required": ["appId", "displayName", "watts", "wattHours"],
      "properties": {
        "appId": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "watts": { "type": "number", "minimum": 0 },
        "wattHours": { "type": "number", "minimum": 0 },
        "components": { "$ref": "#/$defs/rails" },
        "processIds": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "annualCost": { "type": "number", "minimum": 0 }
      }
    },
    "energyTotals": {
      "type": "object",
      "required": ["systemWattHours", "attributedWattHours", "platformWattHours"],
      "properties": {
        "systemWattHours": { "type": "number", "minimum": 0 },
        "attributedWattHours": { "type": "number", "minimum": 0 },
        "platformWattHours": { "type": "number", "minimum": 0 }
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "confidence", "available"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["measured", "estimated", "unavailable"] },
        "available": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "errorDocument": {
      "allOf": [
        { "$ref": "#/$defs/baseDocument" },
        {
          "type": "object",
          "required": ["error"],
          "properties": {
            "ok": { "const": false }
          }
        }
      ]
    },
    "nowDocument": {
      "allOf": [
        { "$ref": "#/$defs/baseDocument" },
        {
          "type": "object",
          "required": ["measurement", "battery"],
          "properties": {
            "command": { "const": "now" },
            "ok": { "const": true },
            "measurement": { "$ref": "#/$defs/measurement" },
            "battery": { "$ref": "#/$defs/battery" }
          }
        }
      ]
    },
    "topDocument": {
      "allOf": [
        { "$ref": "#/$defs/baseDocument" },
        {
          "type": "object",
          "required": ["window", "energy", "apps"],
          "properties": {
            "command": { "const": "top" },
            "ok": { "const": true },
            "window": { "$ref": "#/$defs/window" },
            "energy": { "$ref": "#/$defs/energyTotals" },
            "rate": { "$ref": "#/$defs/rate" },
            "apps": {
              "type": "array",
              "items": { "$ref": "#/$defs/appEnergy" }
            }
          }
        }
      ]
    },
    "sourcesDocument": {
      "allOf": [
        { "$ref": "#/$defs/baseDocument" },
        {
          "type": "object",
          "required": ["sources", "capabilities"],
          "properties": {
            "command": { "const": "sources" },
            "ok": { "const": true },
            "selected": { "type": "string" },
            "sources": {
              "type": "array",
              "items": { "$ref": "#/$defs/source" }
            },
            "capabilities": {
              "type": "object",
              "additionalProperties": { "type": "boolean" }
            }
          }
        }
      ]
    },
    "verifyDocument": {
      "allOf": [
        { "$ref": "#/$defs/baseDocument" },
        {
          "type": "object",
          "required": [
            "seconds",
            "accumulatorWattHours",
            "integratedWattHours",
            "percentDifference",
            "tolerancePercent",
            "sampleCount",
            "passed"
          ],
          "properties": {
            "command": { "const": "verify" },
            "ok": { "const": true },
            "seconds": { "type": "number", "exclusiveMinimum": 0 },
            "accumulatorWattHours": { "type": "number", "minimum": 0 },
            "integratedWattHours": { "type": "number", "minimum": 0 },
            "percentDifference": { "type": "number" },
            "tolerancePercent": { "type": "number", "minimum": 0 },
            "sampleCount": { "type": "integer", "minimum": 1 },
            "passed": { "type": "boolean" }
          }
        }
      ]
    }
  }
}
