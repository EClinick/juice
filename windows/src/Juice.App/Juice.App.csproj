<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Juice.App</RootNamespace>
    <AssemblyName>Juice.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(Platform.ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <!--
      Region and currency resolution depend on real globalization data: invariant mode
      makes RegionInfo.CurrentRegion useless, which breaks electricity rate lookup.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Lets the single-project MSIX tooling activate before the Windows App SDK package has
    been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.5.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!--
      The notification area takes a bitmap, not a string, so the wattage has to be drawn
      into the icon at runtime. GDI+ is the only drawing stack that can hand back an
      HICON, which is what Shell_NotifyIcon requires.
    -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Juice.Core\Juice.Core.csproj" />
    <ProjectReference Include="..\Juice.Platform.Windows\Juice.Platform.Windows.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup>
    <!--

      ReadyToRun is deliberately off. It precompiles IL to native code, which roughly

      doubles the size of every assembly it touches: the Windows API projection grows from

      25 MB to 56 MB and the WinUI assembly from 7 MB to 16 MB, adding around 41 MB per

      architecture to the package.

    

      The trade it offers is faster startup, which matters least for exactly this kind of

      application. Juice is launched once and then sits in the tray for weeks, so it pays

      the download and disk cost on every machine to save a fraction of a second, once.

    -->

    <PublishReadyToRun>false</PublishReadyToRun>
    <!--
      Trimming is off deliberately. The tray icon path goes through GDI+ and the settings
      page through WinRT projections, both of which the trimmer cannot see through, and a
      silently missing type in a tray app that runs for weeks is worse than a larger
      package.
    -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

</Project>
