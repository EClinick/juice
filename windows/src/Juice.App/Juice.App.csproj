<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Juice.App</RootNamespace>
    <AssemblyName>Juice.App</AssemblyName>
    <!--
      The version resource description, which is what Task Manager's Details view shows and
      what this application itself reads to label rows in its own ranking. Without it the
      description defaults to the assembly name, so Juice would appear in its own list as
      "Juice.App", which is the exact unfriendliness the ranking exists to remove.
    -->
    <AssemblyTitle>Juice</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(Platform.ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <!--
      Region and currency resolution depend on real globalization data: invariant mode
      makes RegionInfo.CurrentRegion useless, which breaks electricity rate lookup.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Lets the single-project MSIX tooling activate before the Windows App SDK package has
    been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.5.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!--
      The notification area takes a bitmap, not a string, so the wattage has to be drawn
      into the icon at runtime. GDI+ is the only drawing stack that can hand back an
      HICON, which is what Shell_NotifyIcon requires.
    -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Juice.Core\Juice.Core.csproj" />
    <ProjectReference Include="..\Juice.Platform.Windows\Juice.Platform.Windows.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      ReadyToRun precompiles IL to native code. It costs size and buys startup time, and
      both sides of that were measured rather than assumed.

      Cost: 12.6 MB on arm64 and 14.5 MB on x64, comparing the packages this script
      produces. That is what a user downloads, because an MSIX bundle installs only the
      package matching the machine. The bundle itself grows from 93.4 MB to 120.5 MB, but
      nobody downloads a whole bundle.

      Benefit: median time to a responsive process falls from 160.5 ms to 138.5 ms, over
      fifteen interleaved runs of each configuration with warm-up runs discarded. Process
      cpu time to that point falls from 187.5 ms to 171.9 ms, which is the jit work being
      skipped.

      An earlier revision of this file claimed the opposite, that ReadyToRun made startup
      slower. That measurement was invalid: it timed a layout assembled by copying the
      precompiled assemblies from obj over a build output, and the copy included a stale
      Juice.App.dll from a differently configured build, so the process being timed
      crashed on startup instead of running. Precompiled assemblies are only produced by
      publish, or by build when -r is passed, and they stay in obj until packaging
      substitutes them. If you re-measure this, verify the process is still alive before
      trusting the number.
    -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!--
      Trimming is off deliberately. The tray icon path goes through GDI+ and the settings
      page through WinRT projections, both of which the trimmer cannot see through, and a
      silently missing type in a tray app that runs for weeks is worse than a larger
      package.
    -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

</Project>