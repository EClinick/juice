<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Juice.App.Views.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Juice.App.Views"
    xmlns:vm="using:Juice.App.ViewModels"
    xmlns:controls="using:Juice.App.Controls"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <!--
            Acrylic, not Mica. The Windows material guidance splits the two by surface
            lifetime: acrylic for transient light-dismiss surfaces such as flyouts and
            context menus, Mica for the base layer of long-lived windows. This flyout is
            transient, so acrylic is correct here and Mica is correct in settings.

            Thin rather than the default base acrylic, because this surface sits directly
            over whatever the user was working in and is meant to read as an extension of
            the taskbar. Base acrylic is opaque enough that the window behind it stops
            being legible, which made the flyout read as a flat panel. The declarative
            DesktopAcrylicBackdrop element has no Kind property in this SDK, so the thin
            variant is reached through a SystemBackdrop subclass that owns the controller.
            See ThinAcrylicBackdrop for why nothing else about the material is set there.
        -->
        <local:ThinAcrylicBackdrop />
    </Window.SystemBackdrop>


    <!--
        Scrolls, rather than clipping, when the content cannot fit between the tray and
        the top of the work area. The window is sized from its content and is capped at
        the work area, and a capped window with no scroller would hide the rows past the
        cap without saying so. Losing a measurement silently is the one failure this
        project does not accept.

        A ScrollViewer measures its child with unbounded height, so RootGrid still
        reports its true content height and the window sizing below is unaffected.
    -->
    <ScrollViewer
        x:Name="RootScroller"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">

    <!--
        Top-aligned so the grid sizes to its content rather than stretching to fill the
        window. Its ActualHeight is then the content height and is independent of the
        window height, which is what lets the window be resized from it without the two
        feeding each other.

        It is a tab stop with no focus visual purely so that opening the flyout parks
        focus here rather than on the settings button, which would otherwise appear
        preselected on every open. Focus visuals remain on for the controls themselves,
        so keyboard users still see where they are once they tab.
    -->
    <Grid
        x:Name="RootGrid"
        VerticalAlignment="Top"
        Padding="12,8,12,12"
        IsTabStop="True"
        RowSpacing="4"
        UseSystemFocusVisuals="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <!--
                    The application mark rather than a generic glyph, so the flyout, the
                    tray icon and the entry in the app list all read as the same product.
                -->
                <Image
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" />

                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Juice" />
            </StackPanel>

            <Button
                x:Name="OpenSettingsButton"
                Grid.Column="1"
                MinWidth="28"
                MinHeight="28"
                Padding="4"
                AutomationProperties.AutomationId="FlyoutOpenSettingsButton"
                AutomationProperties.Name="Open Juice settings"
                Click="OnOpenSettingsClick"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Settings">
                <FontIcon
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="14"
                    Glyph="&#xE713;" />
            </Button>
        </Grid>

        <!-- Live readout -->
        <StackPanel Grid.Row="1">
            <TextBlock
                AutomationProperties.AutomationId="FlyoutSystemWatts"
                AutomationProperties.Name="{x:Bind local:FlyoutWindow.ReadoutAnnouncement(ViewModel.WattsText, ViewModel.SourceText), Mode=OneWay}"
                Foreground="{x:Bind local:FlyoutWindow.ReadoutBrush(ViewModel.Severity), Mode=OneWay}"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.WattsText, Mode=OneWay}" />

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.SourceText, Mode=OneWay}" />
        </StackPanel>

        <!-- Battery and supply state -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="8">
            <TextBlock
                AutomationProperties.AutomationId="FlyoutBatteryPercent"
                Foreground="{x:Bind local:FlyoutWindow.BatteryBrush(ViewModel.BatteryLevel), Mode=OneWay}"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.BatteryText, Mode=OneWay}"
                Visibility="{x:Bind local:FlyoutWindow.ToVisibility(ViewModel.HasBattery), Mode=OneWay}" />

            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.PowerStateText, Mode=OneWay}" />
        </StackPanel>

        <!-- Per-rail breakdown -->
        <ItemsControl
            Grid.Row="3"
            ItemsSource="{x:Bind ViewModel.Rails, Mode=OneWay}"
            Visibility="{x:Bind local:FlyoutWindow.ToVisibility(ViewModel.HasRails), Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RailRowViewModel">
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--
                                One strip per rail, with only the matching one shown.

                                Do not replace these with a single Border bound to a brush
                                property on the row. A Brush handed over by a view model is
                                the instance from whichever theme dictionary was active
                                when the row was built, and bindings inside a DataTemplate
                                are not reachable from the window's Bindings.Update(), so
                                on a light or dark switch the strip would keep painting the
                                old theme's colour. Selecting the brush declaratively with
                                ThemeResource is what makes it follow the system theme,
                                including high contrast.
                            -->
                            <Border
                                Grid.Column="0"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Visibility="{x:Bind local:FlyoutWindow.ToVisibility(IsCpu), Mode=OneWay}" />
                            <Border
                                Grid.Column="0"
                                Background="{ThemeResource SystemFillColorSuccessBrush}"
                                Visibility="{x:Bind local:FlyoutWindow.ToVisibility(IsGpu), Mode=OneWay}" />
                            <Border
                                Grid.Column="0"
                                Background="{ThemeResource SystemFillColorAttentionBrush}"
                                Visibility="{x:Bind local:FlyoutWindow.ToVisibility(IsNpu), Mode=OneWay}" />
                            <Border
                                Grid.Column="0"
                                Background="{ThemeResource TextFillColorTertiaryBrush}"
                                Visibility="{x:Bind local:FlyoutWindow.ToVisibility(IsSupply), Mode=OneWay}" />

                            <StackPanel Grid.Column="1" Margin="12,8">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Name, Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind WattsText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Energy history. Gaps are rendered as gaps; see EnergyChartBuilder. -->
        <StackPanel
            Grid.Row="4"
            Spacing="4"
            Visibility="{x:Bind local:FlyoutWindow.ToVisibility(ViewModel.HasHistory), Mode=OneWay}">
            <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Last 24 hours" />

            <controls:EnergyHistoryChart
                Height="40"
                AutomationProperties.AutomationId="FlyoutHistoryChart"
                Series="{x:Bind ViewModel.History, Mode=OneWay}" />

            <TextBlock
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind local:FlyoutWindow.HistoryCaption(ViewModel.History), Mode=OneWay}"
                TextWrapping="Wrap" />

            <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Battery level"
                Visibility="{x:Bind local:FlyoutWindow.ToVisibility(ViewModel.HasCharge), Mode=OneWay}" />

            <controls:ChargeTimelineChart
                Height="56"
                AutomationProperties.AutomationId="FlyoutChargeTimeline"
                Timeline="{x:Bind ViewModel.Charge, Mode=OneWay}"
                Visibility="{x:Bind local:FlyoutWindow.ToVisibility(ViewModel.HasCharge), Mode=OneWay}" />

            <TextBlock
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind local:FlyoutWindow.ChargeCaption(ViewModel.Charge), Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind local:FlyoutWindow.ToVisibility(ViewModel.HasCharge), Mode=OneWay}" />
        </StackPanel>

        <!-- Recording status, shown only while there is not yet enough history to chart. -->
        <TextBlock
            Grid.Row="4"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind local:FlyoutWindow.HistoryCaption(ViewModel.History), Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind local:FlyoutWindow.ToVisibilityInverse(ViewModel.HasHistory), Mode=OneWay}" />

        <!-- Top energy users -->
        <Grid Grid.Row="5" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Top energy users" />

            <TextBlock
                Grid.Row="1"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.EnergyWindowText, Mode=OneWay}"
                TextWrapping="Wrap" />

            <ItemsControl
                Grid.Row="2"
                AutomationProperties.AutomationId="FlyoutEnergyList"
                AutomationProperties.Name="Top energy users"
                ItemsSource="{x:Bind ViewModel.EnergyRows, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EnergyRowViewModel">
                        <Grid MinHeight="36" AutomationProperties.Name="{x:Bind local:FlyoutWindow.RowAnnouncement(IsPlaceholder, DisplayName, WattsText, CostText), Mode=OneWay}">
                            <!--
                                MinHeight pins the row to the height of a populated row,
                                which is one body line over one caption line. It is what
                                keeps a placeholder row and a real row exactly the same
                                height, so the list does not resize the window when the
                                first measurement lands.
                            -->
                            <!--
                                Ranking bar. It is a star sized column rather than a pixel
                                width so it stays proportional at any flyout width, and it
                                sits behind the text rather than beside it so ranking
                                costs no row height. The fill is translucent, which means
                                it all but disappears under high contrast: that is the
                                right way for it to fail, because the ordering and the
                                watts still carry the ranking on their own.

                                The two fills are separate Borders toggled by IsPlatform
                                rather than one Border taking a brush from the row, for the
                                same reason as the rail strips above: a view model brush
                                would be captured from one theme dictionary and could not
                                be refreshed from inside a DataTemplate on a theme switch.
                                Only the theme independent values, the GridLengths and the
                                Visibilities, come from function bindings here.
                            -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Bind local:FlyoutWindow.BarLength(BarFraction), Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind local:FlyoutWindow.BarRemainderLength(BarFraction), Mode=OneWay}" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    Opacity="0.18"
                                    Visibility="{x:Bind local:FlyoutWindow.ToVisibilityInverse(IsPlatform), Mode=OneWay}" />

                                <Border
                                    Grid.Column="0"
                                    Background="{ThemeResource TextFillColorTertiaryBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    Opacity="0.15"
                                    Visibility="{x:Bind local:FlyoutWindow.ToVisibility(IsPlatform), Mode=OneWay}" />
                            </Grid>

                            <Grid Padding="8,0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--
                                    The app's own icon, per CONTRIBUTING.md. The column is
                                    a fixed width rather than Auto so the names stay
                                    aligned whether or not an icon could be extracted.
                                -->
                                <Image
                                    Grid.Column="0"
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Source="{x:Bind Icon, Mode=OneWay}"
                                    Visibility="{x:Bind local:FlyoutWindow.ToVisibilityIfPresent(Icon), Mode=OneWay}" />

                                <FontIcon
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE7F4;"
                                    Visibility="{x:Bind local:FlyoutWindow.ToVisibility(IsPlatform), Mode=OneWay}" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        Text="{x:Bind DisplayName, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind CostText, Mode=OneWay}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind WattsText, Mode=OneWay}" />

                                <!--
                                    Placeholder blocks, shown only until the first
                                    attribution window closes. They are blank on purpose:
                                    a zero or a dash in these positions would read as a
                                    measurement, and there is not one yet. They occupy the
                                    same three columns as the real content so nothing
                                    shifts sideways when the row fills in.
                                -->
                                <Border
                                    Grid.Column="0"
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource TextFillColorTertiaryBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    Opacity="0.15"
                                    Visibility="{x:Bind local:FlyoutWindow.ToVisibility(IsPlaceholder), Mode=OneWay}" />

                                <Border
                                    Grid.Column="1"
                                    Width="112"
                                    Height="10"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource TextFillColorTertiaryBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    Opacity="0.15"
                                    Visibility="{x:Bind local:FlyoutWindow.ToVisibility(IsPlaceholder), Mode=OneWay}" />

                                <Border
                                    Grid.Column="2"
                                    Width="40"
                                    Height="10"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource TextFillColorTertiaryBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    Opacity="0.15"
                                    Visibility="{x:Bind local:FlyoutWindow.ToVisibility(IsPlaceholder), Mode=OneWay}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Rate provenance -->
        <StackPanel Grid.Row="6" Spacing="4">
            <Border
                Height="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <TextBlock
                AutomationProperties.AutomationId="FlyoutRateFooter"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.RateFooterText, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
